// EduVanta AI â€” Database Schema
// PostgreSQL + Prisma. pgvector extension used for RAG embeddings (see LearningMaterialChunk).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ==========================================================================
// AUTH / IDENTITY
// ==========================================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
  // PARENT reserved for future use â€” schema below already supports linking
  // a parent to a student via ParentLink without a migration change.
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String? // null when using Supabase-managed auth only
  role          Role     @default(STUDENT)
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile          Profile?
  conversations    Conversation[]
  attempts         Attempt[]
  studySessions    StudySession[]
  studyPlans       StudyPlan[]
  masteries        Mastery[]
  mistakes         Mistake[]
  examAttempts     ExamAttempt[]
  achievements     Achievement[]
  streak           Streak?
  notifications    Notification[]
  coursesTaught    Course[]        @relation("TeacherCourses")
  assignmentsMade  Assignment[]    @relation("TeacherAssignments")
  enrollments      Enrollment[]
  recommendations  Recommendation[]
  subscription     Subscription?
  payments         Payment[]
  parentLinksAsChild  ParentLink[] @relation("ChildLinks")
  parentLinksAsParent ParentLink[] @relation("ParentLinks")

  @@index([email])
}

// Placeholder join table so PARENT role can be added later with zero schema churn.
model ParentLink {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id])
  child     User     @relation("ChildLinks", fields: [childId], references: [id])
  createdAt DateTime @default(now())

  @@unique([parentId, childId])
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName          String?
  examGoal          String? // e.g. "JEE", "NEET", "School", "Self Learning"
  targetExamDate    DateTime?
  currentLevel      String? // beginner / intermediate / advanced (self-reported at onboarding)
  dailyStudyMinutes Int?
  preferredDifficulty String? // easy | medium | hard | adaptive
  learningGoal      String?
  onboardedAt       DateTime?
  timezone          String   @default("UTC")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ==========================================================================
// CONTENT HIERARCHY
// ==========================================================================

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  examGoal    String? // links course to an exam track e.g. "JEE"
  teacherId   String?
  teacher     User?    @relation("TeacherCourses", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects    Subject[]
  assignments Assignment[]
  enrollments Enrollment[]

  @@index([teacherId])
}

// Links a student to the courses they're actually taking. Added after the
// rest of the schema â€” see DATABASE.md "Known schema gap" for why this
// didn't exist earlier and what depended on it being missing.
model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model Subject {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name     String
  order    Int     @default(0)

  topics Topic[]

  @@index([courseId])
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subtopics    Subtopic[]
  concepts     Concept[]
  questions    Question[]
  masteries    Mastery[]
  materials    LearningMaterial[]

  @@index([subjectId])
}

model Subtopic {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name    String
  order   Int    @default(0)

  questions Question[]
  masteries Mastery[]

  @@index([topicId])
}

// A Concept is finer-grained than a subtopic â€” this is what mastery is
// ultimately tracked against (e.g. "function composition" within "Functions").
model Concept {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name    String
  description String?

  questions Question[]
  masteries Mastery[]
  mistakes  Mistake[]

  @@index([topicId])
}

// ==========================================================================
// QUESTIONS / PRACTICE
// ==========================================================================

enum QuestionType {
  MCQ
  MULTI_SELECT
  TRUE_FALSE
  NUMERICAL
  SHORT_ANSWER
  CODING
  CASE_BASED
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionSource {
  HUMAN
  AI_GENERATED
}

model Question {
  id            String          @id @default(cuid())
  topicId       String?
  topic         Topic?          @relation(fields: [topicId], references: [id])
  subtopicId    String?
  subtopic      Subtopic?       @relation(fields: [subtopicId], references: [id])
  conceptId     String?
  concept       Concept?        @relation(fields: [conceptId], references: [id])
  type          QuestionType
  difficulty    DifficultyLevel
  prompt        String
  explanation   String?
  source        QuestionSource  @default(HUMAN)
  validated     Boolean         @default(false)
  correctAnswer Json // shape depends on QuestionType; validated server-side, never trust client
  metadata      Json? // learning objective, tags, estimated time, etc.
  createdAt     DateTime        @default(now())

  options       QuestionOption[]
  answers       Answer[]
  mistakes      Mistake[]
  examQuestions ExamQuestion[]

  @@index([topicId])
  @@index([subtopicId])
  @@index([conceptId])
  @@index([difficulty])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)

  @@index([questionId])
}

// One practice/exam "sitting" â€” groups a set of Answers.
model Attempt {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          String // "practice" | "focus" | "exam"
  topicId       String?
  examAttemptId String?  @unique // set when mode = "exam"; links this Attempt's Answers to the ExamAttempt
  examAttempt   ExamAttempt? @relation(fields: [examAttemptId], references: [id])
  startedAt     DateTime @default(now())
  finishedAt    DateTime?

  answers Answer[]

  @@index([userId])
  @@index([topicId])
}

model Answer {
  id             String   @id @default(cuid())
  attemptId      String
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id])
  studentAnswer  Json
  isCorrect      Boolean
  timeTakenMs    Int
  confidence     Int? // optional self-reported 1-5
  markedForReview Boolean @default(false) // exam mode: "mark for review" flag
  createdAt      DateTime @default(now())

  @@unique([attemptId, questionId]) // one answer per question per attempt â€” resubmits update in place (auto-save)
  @@index([attemptId])
  @@index([questionId])
}

// ==========================================================================
// MASTERY ENGINE
// ==========================================================================

enum MasteryBand {
  NEEDS_ATTENTION
  DEVELOPING
  STRONG
  MASTERED
}

// Mastery is stored per (user, scope) where scope is exactly one of
// topicId / subtopicId / conceptId â€” see services/mastery for the scoring logic.
model Mastery {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String?
  topic      Topic?       @relation(fields: [topicId], references: [id])
  subtopicId String?
  subtopic   Subtopic?    @relation(fields: [subtopicId], references: [id])
  conceptId  String?
  concept    Concept?     @relation(fields: [conceptId], references: [id])
  score      Float        @default(0) // 0-100, computed â€” see MASTERY_ALGORITHM.md
  band       MasteryBand  @default(NEEDS_ATTENTION)
  trend      Float        @default(0) // delta vs previous computation
  lastUpdated DateTime    @updatedAt

  @@unique([userId, topicId, subtopicId, conceptId])
  @@index([userId])
}

// ==========================================================================
// MISTAKE INTELLIGENCE
// ==========================================================================

model Mistake {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question @relation(fields: [questionId], references: [id])
  conceptId     String?
  concept       Concept? @relation(fields: [conceptId], references: [id])
  studentAnswer Json
  correctAnswer Json
  mistakeType   String // "conceptual" | "careless" | "procedural" | "misread" ...
  explanation   String?
  occurrences   Int      @default(1)
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([conceptId])
}

// ==========================================================================
// STUDY PLANNING
// ==========================================================================

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  examGoal    String?
  targetDate  DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions StudySession[]

  @@index([userId])
}

model StudySession {
  id          String    @id @default(cuid())
  studyPlanId String?
  studyPlan   StudyPlan? @relation(fields: [studyPlanId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  durationMin Int
  topicLabel  String // denormalized label shown in UI, e.g. "Functions basics"
  status      String   @default("pending") // pending | done | missed | rescheduled
  completedAt DateTime?

  @@index([userId])
  @@index([studyPlanId])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  reason    String
  actionLabel String
  actionHref  String
  priority  Int      @default(0)
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==========================================================================
// EXAMS
// ==========================================================================

model Exam {
  id          String   @id @default(cuid())
  title       String
  courseId    String?
  durationMin Int
  createdAt   DateTime @default(now())

  attempts      ExamAttempt[]
  examQuestions ExamQuestion[]
}

// Join table fixing the exact, ordered set of questions in an exam â€” the
// exam simulator needs a stable set/order for navigation, unlike adaptive
// practice which picks questions on the fly.
model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      @default(0)

  @@unique([examId, questionId])
  @@index([examId])
}

model ExamAttempt {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  score      Float?
  report     Json? // structured AI report: topic performance, time analysis, mistake breakdown

  attempt Attempt? // the underlying practice-style Attempt holding this exam's Answers

  @@index([userId])
  @@index([examId])
}

// ==========================================================================
// AI TUTOR (Nova)
// ==========================================================================

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant" | "system"
  content        String
  metadata       Json? // e.g. structured practice_feedback payload
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ==========================================================================
// RAG / LEARNING MATERIAL
// ==========================================================================

model LearningMaterial {
  id        String   @id @default(cuid())
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id])
  uploaderId String
  fileName  String
  fileType  String
  status    String   @default("processing") // processing | ready | failed
  createdAt DateTime @default(now())

  chunks LearningMaterialChunk[]

  @@index([topicId])
}

model LearningMaterialChunk {
  id                 String            @id @default(cuid())
  learningMaterialId String
  learningMaterial   LearningMaterial  @relation(fields: [learningMaterialId], references: [id], onDelete: Cascade)
  content            String
  chunkIndex         Int
  // Embedding vector â€” dimension depends on the embedding model configured;
  // see AI_ARCHITECTURE.md. Declared as Unsupported until an embedding
  // model + dimension is locked in, then swap to `Unsupported("vector(1536)")`.
  embedding          Unsupported("vector")?

  @@index([learningMaterialId])
}

// ==========================================================================
// TEACHER TOOLING
// ==========================================================================

model Assignment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherAssignments", fields: [teacherId], references: [id])
  title     String
  dueDate   DateTime?
  createdAt DateTime @default(now())
}

// ==========================================================================
// GAMIFICATION
// ==========================================================================

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "mastery_milestone" | "personal_best" | "weekly_goal" ...
  label     String
  earnedAt  DateTime @default(now())

  @@index([userId])
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDate DateTime?
}

// ==========================================================================
// NOTIFICATIONS
// ==========================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "study_reminder" | "assignment_due" | "exam_reminder" | "recommendation" | "streak"
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum PlanType {
  FREE
  STUDENT
  PRO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      PlanType @default(FREE)
  active    Boolean  @default(true)
  startedAt DateTime @default(now())
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([plan])
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          PlanType
  amount        Int
  transactionId String
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  reviewedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@unique([transactionId])
}



