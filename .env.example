# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/eduvanta"

# ── Auth (Supabase) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
AUTH_SECRET=""

# ── AI Provider ─────────────────────────────────────────────────────────
# Which provider to use: "anthropic" | "openai" | "gemini"
AI_PROVIDER="anthropic"

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# If none of the above keys are set, the app falls back to a mock AI
# provider in development (NODE_ENV=development) and throws loudly in
# production so a missing key is never silently mocked.
#
# RAG embeddings specifically require OPENAI_API_KEY regardless of
# AI_PROVIDER above — Anthropic and this app's Gemini provider don't
# implement embeddings, so uploaded course material won't be searchable
# without an OpenAI key even if you're using Anthropic for chat.

NODE_ENV="development"

# Vercel cron authentication
CRON_SECRET=replace-with-a-long-random-secret
DIRECT_URL="postgresql://user:password@localhost:5432/eduvanta"

# Nova monthly token quotas
NOVA_FREE_TOKENS=25000
NOVA_STARTER_TOKENS=100000
NOVA_PRO_TOKENS=300000
NOVA_PREMIUM_TOKENS=750000
NOVA_DEFAULT_PAID_TOKENS=150000
